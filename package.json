{
  "name": "issue-runner-agent-codex",
  "version": "1.0.4",
  "description": "Terminal-independent Codex enhancement for Issue Runner",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.*\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "release:accept": "node --test tests/package/package.test.ts",
    "release:pack": "node scripts/release/pack-candidate.ts",
    "release:publish": "node scripts/release/publish-release.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "@types/ws": "8.18.2",
    "eslint": "10.10.0",
    "issue-runner-core": "1.0.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuddyLabsCo/issue-runner-agent-codex.git"
  },
  "keywords": [
    "issue-runner",
    "codex",
    "openai-codex",
    "agent-enhancement",
    "ai-agent",
    "coding-agent",
    "github-issues",
    "workflow-automation"
  ]
}
